rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ttapse12@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    // Public test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles & credentials
    match /users/{userId} {
      // Allow reading user profiles if signed in, or lookup during authentication
      allow read: if true;
      // Allow user creation by admins or initial self-registration/seed
      allow create: if true;
      // Allow user profile updates
      allow update: if isSignedIn() || isSuperAdmin();
      // Allow user deletion by superadmin
      allow delete: if isSignedIn();
    }

    // Tasks & Deliverables
    match /tasks/{taskId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Chat Groups & Channels
    match /chat_groups/{groupId} {
      allow read: if true;
      allow create, update, delete: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
    }

    // Standalone Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Teams
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Resources & Projects
    match /resources/{resId} {
      allow read, write: if true;
    }
    match /projects/{projId} {
      allow read, write: if true;
    }
  }
}
