{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forencluework",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/storage/*"]
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "forenclue-uploads"
    }
  ]
}
